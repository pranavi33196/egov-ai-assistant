# ─────────────────────────────────────────────────────────────
#  e-Gov AI Assistant — backend/.env template (copy to .env, never commit .env)
# ─────────────────────────────────────────────────────────────

# ── JWT ──────────────────────────────────────────────────────
# REQUIRED. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database / URLs ──────────────────────────────────────────
DATABASE_URL=sqlite:///./egov.db
FRONTEND_URL=http://localhost:5173

# ── Gmail SMTP (OTP email). If left empty the API returns a dev_otp for testing ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ── Captcha ──────────────────────────────────────────────────
# WARNING: leave these EMPTY until the Login page sends a captcha token.
# Backend enforces captcha on /register and /login once a secret is set.
CAPTCHA_PROVIDER=turnstile
CLOUDFLARE_TURNSTILE_SECRET=
RECAPTCHA_SECRET_KEY=

# ── Bhashini (optional) ──────────────────────────────────────
# All three are needed for is_configured() to be true.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_AUTH_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_MODE=mock

# ── LLM ──────────────────────────────────────────────────────
# auto/ollama = try Ollama, fall back to rule-based; rules = never call Ollama
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=60

# ── RAG ──────────────────────────────────────────────────────
# Optional relevance cutoff (lower = stricter). Tune using the "[RAG] ..." log lines.
# RAG_MAX_DISTANCE=1.2

# ── TTS ──────────────────────────────────────────────────────
TTS_MAX_CHARS=1500

# ── Google OAuth (optional) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
