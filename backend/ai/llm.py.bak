import os
import requests
import logging

logger = logging.getLogger(__name__)

def generate_answer(query: str, context_chunks: list) -> str:
    """
    Produces a crisp, high-impact citizen service advisory from RAG chunks.
    Kept concise so translation to Telugu/Hindi completes in ~1.5 seconds.
    """
    if not context_chunks:
        return (
            "I could not find official information regarding your query in the Government Knowledge Base. "
            "Please check the National Government Services Portal at https://services.india.gov.in "
            "or visit your local citizen service center (CSC / MeeSeva)."
        )

    return generate_structured_synthesis(query, context_chunks)


def generate_structured_synthesis(query: str, context_chunks: list) -> str:
    """
    Extracts structured government advisory from RAG chunks with clear bullet points.
    Compact and structured for fast multilingual translation.
    """
    chunk = context_chunks[0] if context_chunks else ""
    lines = chunk.split("\n")

    service = "Citizen Service"
    desc = ""
    eligibility = ""
    documents = ""
    process = []
    portal = ""
    helpline = ""

    in_process = False
    for line in lines:
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("SERVICE:"):
            service = stripped.replace("SERVICE:", "").strip()
            in_process = False
        elif stripped.startswith("DESCRIPTION:"):
            desc = stripped.replace("DESCRIPTION:", "").strip()
            in_process = False
        elif stripped.startswith("GENERAL ELIGIBILITY:"):
            eligibility = stripped.replace("GENERAL ELIGIBILITY:", "").strip()
            in_process = False
        elif stripped.startswith("REQUIRED DOCUMENTS:"):
            documents = stripped.replace("REQUIRED DOCUMENTS:", "").strip()
            in_process = False
        elif stripped.startswith("APPLICATION PROCESS:"):
            in_process = True
        elif stripped.startswith("OFFICIAL PORTAL:"):
            portal = stripped.replace("OFFICIAL PORTAL:", "").strip()
            in_process = False
        elif stripped.startswith("HELPLINE:"):
            helpline = stripped.replace("HELPLINE:", "").strip()
            in_process = False
        elif in_process and len(process) < 4:
            process.append(stripped)

    out = []
    out.append(f"### {service}")

    if desc:
        out.append(f"Overview: {desc}")

    if eligibility:
        out.append(f"Eligibility: {eligibility}")

    if documents:
        doc_items = [d.strip() for d in documents.split(",") if d.strip()][:4]
        out.append("Required Documents: " + ", ".join(doc_items))

    if process:
        out.append("Procedure: " + " ".join(process[:3]))

    if portal or helpline:
        parts = []
        if portal:
            parts.append(f"Portal: {portal}")
        if helpline:
            parts.append(f"Helpline: {helpline}")
        out.append("Official Info: " + " | ".join(parts))

    return "\n\n".join(out)
